<application>
    <name>ParamRules</name>
    <def-param-value name="id">c1</def-param-value>
    <def-param-value name="other">c2</def-param-value>
    <connection id="$PAR{id}">
        <from>/a/out</from>
        <to>/arb/in</to>
    </connection>
    <connection id="c2">
        <from>/b/out</from>
        <to>/arb/in</to>
    </connection>
    <arbitrator>
        <port>/arb/in</port>
        <rule connection="$PAR{id}">~$PAR{other}</rule>
        <rule connection="c2">~c1</rule>
    </arbitrator>
</application>
