# Suppress memory leaks from libgsl static initialization.
# These allocations happen inside _dl_open when libgsl.so is loaded
# for the first time (e.g. in sig::MatrixTest via YARP_gsl).
# They are intentional: GSL allocates global state during library init
# that is never freed explicitly, relying on OS cleanup at process exit.

{
   libgsl_dl_open_leak_1
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:_dl_init
   fun:_dl_open
   ...
}

{
   libgsl_dl_open_leak_2
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:call_init.part.0
   fun:_dl_init
   ...
}

# glibc (ld.so) false positive.
# When a dlopen()ed library gets a new scope array (resize_scopes) in a
# multi-threaded process, the old array is not freed immediately but queued in
# GL(dl_scope_free_list) (see _dl_scope_free). The queue is flushed only by
# _dl_close_worker(), which is never executed for NODELETE objects (e.g. YARP
# plugins containing STB_GNU_UNIQUE symbols). At exit __libc_freeres() drops
# the queue, and valgrind reports the pending arrays as "definitely lost".
# Seen in os::ListPluginsAndOpenTest.
{
   glibc_dlopen_resize_scopes_deferred_free
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:resize_scopes
   ...
   fun:_dl_open
}
